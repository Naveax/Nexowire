# Hub
NEXOWIRE_HTTP_HOST=127.0.0.1
NEXOWIRE_HTTP_PORT=43110

# Required before binding the hub to a non-loopback interface.
# Single token remains supported. During rotation, comma-separate old/current/next tokens below.
NEXOWIRE_MCP_BEARER_TOKEN=
NEXOWIRE_MCP_BEARER_TOKENS=

# Agent authentication. Required for non-loopback deployments.
NEXOWIRE_AGENT_TOKEN=
NEXOWIRE_AGENT_TOKENS=

# Direct TLS for non-loopback hub exposure.
# Both files are required together. Prefer a certificate trusted by ChatGPT/agents.
NEXOWIRE_TLS_CERT_FILE=
NEXOWIRE_TLS_KEY_FILE=
# Trusted-private-network escape hatch only. Plaintext non-loopback transport is refused by default.
NEXOWIRE_ALLOW_INSECURE_REMOTE=

# Native agent
# Use wss:// when the hub uses direct TLS.
NEXOWIRE_HUB_WS_URL=ws://127.0.0.1:43110/agent
NEXOWIRE_DEVICE_NAME=
# Semicolon-separated on Windows, colon-separated on Linux/macOS.
# Defaults to the current user's home directory.
NEXOWIRE_ALLOWED_ROOTS=
NEXOWIRE_STATE_DIR=

# Native-agent process-session metadata (commands/output are not persisted)
NEXOWIRE_PROCESS_STATE_FILE=
