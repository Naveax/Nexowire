{
  "name": "nexowire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native remote computer control hub for ChatGPT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "check": "npm run typecheck && npm run continuation:check && npm test",
    "dev": "tsx src/cli.ts",
    "dev:http": "tsx src/cli.ts http",
    "dev:stdio": "tsx src/cli.ts stdio",
    "dev:agent": "tsx src/cli.ts agent",
    "start": "node dist/src/cli.js http",
    "start:agent": "node dist/src/cli.js agent",
    "dev:relay": "tsx src/cli.ts relay",
    "start:relay": "node dist/src/cli.js relay",
    "dev:privileged-broker": "tsx src/cli.ts privileged-broker",
    "start:privileged-broker": "node dist/src/cli.js privileged-broker",
    "mcp:contract:generate": "node --import tsx scripts/generate-mcp-v1-contract.ts",
    "continuation:check": "node --import tsx scripts/check-continuation-state.ts",
    "mcp:output-contract:generate": "node --import tsx scripts/generate-mcp-v1-output-contract.ts",
    "release:check": "npm run check && npm run build && node --import tsx scripts/check-release-package.ts",
    "release:verify": "node --import tsx scripts/verify-release-candidate.ts",
    "release:tag:check": "node --import tsx scripts/check-release-tag.ts",
    "control-plane:bootstrap": "node --import tsx scripts/bootstrap-cloudflare-control-plane.ts",
    "billing:provision": "node --import tsx scripts/provision-lemonsqueezy-production.ts",
    "cloudflare:ci-provision": "node --import tsx scripts/provision-cloudflare-github-actions.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ws": "^8.18.0",
    "zod": "^4.1.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/express": "^5.0.0"
  },
  "bin": {
    "nexowire": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "skills",
    "README.md"
  ]
}
